prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libimx708
Description: Userspace library for Sony IMX708 camera sensor control
Version: @DRV_VERSION@
Libs: -L${libdir} -limx708
Cflags: -I${includedir}
